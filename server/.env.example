# Copy to .env and adjust. All values are optional.

# API port (the server always binds to 127.0.0.1).
PORT=4000

# Keep the database outside OneDrive. Default: %LOCALAPPDATA%\ScopeScan\scopescan.db
# DB_PATH=C:\Users\you\AppData\Local\ScopeScan\scopescan.db

# Paths to the scanners, if they aren't on PATH.
# NUCLEI_PATH=C:\tools\nuclei.exe
# FFUF_PATH=C:\tools\ffuf.exe
# NMAP_PATH=C:\Program Files (x86)\Nmap\nmap.exe

# Wordlist for ffuf (required to run ffuf). SecLists' Discovery/Web-Content/common.txt is a good start.
FFUF_WORDLIST=C:\tools\wordlists\common.txt

# A scan that runs longer than this is killed and marked "timed out". Default: 60.
# SCAN_TIMEOUT_MINUTES=60

# How many scans may run at once (1 or 2; more is refused). Default: 1.
# SCAN_CONCURRENCY=1

# AI triage with a local model (Ollama). Must be on this computer: scan data never leaves it.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
# Set to off to skip AI triage entirely.
# AI_TRIAGE=on

# Origins allowed to make changes (the React dev server).
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
